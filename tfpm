#!/usr/bin/env bash
# tfpm — TF pair miner: setup, mine (wr or local), status, publish.
# Settings come from env vars or ./tfpm.conf (KEY=value lines):
#   TFPM_OUT (default: <repo>/run)   TFPM_CENSUS (2025-11-08)   TFPM_SHARDS (100)
#   TFPM_TF_SET (exploratory)        TFPM_PYTHON (python3.12/3.11 auto)  TFPM_WR_MEM (32G)
#   TFPM_WR_TIME (24h)  TFPM_WR_CPUS (4)  TFPM_WR_QUEUE (optional LSF queue)
set -euo pipefail
ROOT="$(cd "$(dirname "$(readlink -f "$0")")" && pwd)"
[ -f "$ROOT/tfpm.conf" ] && . "$ROOT/tfpm.conf"
OUT="$(readlink -m "${TFPM_OUT:-$ROOT/run}")"
CENSUS="${TFPM_CENSUS:-2025-11-08}"
SHARDS="${TFPM_SHARDS:-100}"
TF_SET="${TFPM_TF_SET:-exploratory}"
VENV="$ROOT/.venv"; PY="$VENV/bin/python"
MINER="$ROOT/mining/tf_census.py"
COMP="$ROOT/compendium"
die(){ echo "tfpm: $*" >&2; exit 1; }
usage(){ cat <<U
Usage:
  tfpm setup [compendium.xlsx]          venv + deps + tests + TSV export + Census plan
  tfpm mine --runner wr|local [--parallel N] [--pilot] [-- extra tf_census.py run options]
  tfpm status                           progress (wr queue or local logs) + datasets done
  tfpm publish [--run DIR] [--label T]  validate -> aggregate if needed -> versioned JSON -> git commit + push
  tfpm embed [--run DIR] [--max-cells N] optional UMAP + per-cell TF expression layer for the site (then publish)
  tfpm publish ... --embed              publish including the embedding layer
  tfpm replicate --runner wr|local [--run DIR] [-- plan flags e.g. --min-codetected 25 --assay-id EFO:0009922]
                                        Tabula Sapiens replication of the run's candidates (publish picks it up)
  tfpm atac --runner wr|local [--run DIR] [--proxy-fetal "Fetal Cholangiocyte=CL:0002538@UBERON:0002107"]
                                        CATlas same-cCRE motif co-enrichment for replicated pairs (needs TFPM_GENOME_FASTA,
                                        fimo, bedtools when any cluster maps; proxy runs are labelled proxy_fetal)
  tfpm aggregate                        (run automatically by mine; re-aggregates safely)
Output dir: $OUT   Census: $CENSUS   Shards: $SHARDS
U
}
shard_cmd(){ echo "$PY $MINER run --out $OUT --num-shards $SHARDS --shard-index $1 --batch-size 1000 --tmpdir \"\${TMPDIR:-/tmp}\""; }

cmd_setup(){
  local x="${1:-}"
  if [ ! -x "$PY" ]; then
    local base="${TFPM_PYTHON:-}"
    if [ -z "$base" ]; then for c in python3.12 python3.11 python3; do command -v "$c" >/dev/null && { base="$c"; break; }; done; fi
    [ -n "$base" ] || die "no python found; set TFPM_PYTHON=/path/to/python3.12"
    "$base" -c 'import sys; assert sys.version_info[:2] in ((3,11),(3,12)), sys.version' 2>/dev/null \
      || echo "tfpm: warning: $base is not Python 3.11/3.12 (tested versions); continuing" >&2
    "$base" -m venv "$VENV"
  fi
  "$PY" -m pip install -q --upgrade pip
  "$PY" -m pip install -q -r "$ROOT/mining/requirements.txt"
  (cd "$ROOT/mining" && "$PY" -m unittest -q test_tf_census)
  if [ -n "$x" ]; then "$PY" "$ROOT/scripts/export_compendium.py" "$x" --outdir "$COMP"; fi
  [ -f "$COMP/gene_register.tsv" ] || die "no compendium TSVs; run: tfpm setup /path/to/compendium.xlsx"
  if [ -f "$OUT/manifest.json" ]; then echo "Plan already exists in $OUT (kept for provenance)."; else
    "$PY" "$MINER" plan --register "$COMP/gene_register.tsv" --out "$OUT" --census-version "$CENSUS" --tf-set "$TF_SET"
  fi
  echo "Setup done. Next: tfpm mine --runner wr   (or --runner local)"
}

cmd_aggregate(){
  [ -f "$OUT/manifest.json" ] || die "no plan in $OUT; run tfpm setup"
  if [ -d "$OUT/aggregate" ]; then mv "$OUT/aggregate" "$OUT/aggregate.old.$(date +%Y%m%d-%H%M%S)"; fi
  "$PY" "$MINER" aggregate --out "$OUT" --interaction-priors "$COMP/interaction_priors.tsv"
}

cmd_mine(){
  local runner="" par=6 extra=""
  while [ $# -gt 0 ]; do case "$1" in
    --runner) runner="$2"; shift 2;; --parallel|-P) par="$2"; shift 2;;
    --pilot) extra="$extra --min-cells 20 --max-strata 1"; shift;;
    --) shift; extra="$extra $*"; break;; *) die "unknown option $1";; esac; done
  extra="${TFPM_RUN_ARGS:-} $extra"
  [ -f "$OUT/manifest.json" ] || die "no plan in $OUT; run tfpm setup first"
  mkdir -p "$OUT/logs"
  local jobs="$OUT/jobs.txt"; : > "$jobs"
  for ((i=0;i<SHARDS;i++)); do echo "$(shard_cmd $i) $extra" >> "$jobs"; done
  case "$runner" in
    wr)
      command -v wr >/dev/null || die "wr not on PATH"
      wr manager status >/dev/null 2>&1 || die "no wr manager running; start it with: wr manager start"
      local q=(); [ -n "${TFPM_WR_QUEUE:-}" ] && q=(--queue "$TFPM_WR_QUEUE")
      # -i is wr's reporting group (alias of --rep_grp); -e = --dep_grps; -d = --deps
      wr add -f "$jobs" -i tfpm-mine -e tfpm_shards -m "${TFPM_WR_MEM:-32G}" -t "${TFPM_WR_TIME:-24h}" \
         --cpus "${TFPM_WR_CPUS:-4}" -r 3 "${q[@]}"
      echo "$ROOT/tfpm aggregate" | wr add -i tfpm-aggregate -d tfpm_shards -m 16G -t 4h -r 1 "${q[@]}"
      echo "Queued $SHARDS shard jobs + 1 dependent aggregate job. Check with: tfpm status";;
    local)
      echo "local $par $(date -Is)" > "$OUT/logs/local.started"
      setsid nohup bash -c "seq 0 $((SHARDS-1)) | xargs -P $par -I{} bash -c '$(shard_cmd {}) $extra > $OUT/logs/shard_{}.log 2>&1 && echo {} >> $OUT/logs/shards.done || echo {} >> $OUT/logs/shards.failed'; '$ROOT/tfpm' aggregate > $OUT/logs/aggregate.log 2>&1 && touch $OUT/logs/local.finished" \
        > "$OUT/logs/local.log" 2>&1 &
      echo "Started $SHARDS shards locally, $par in parallel (pid $!). Safe to log out. Check with: tfpm status";;
    *) die "use --runner wr or --runner local";;
  esac
}

cmd_status(){
  [ -f "$OUT/datasets.tsv" ] || die "no plan in $OUT"
  local planned done_; planned=$(( $(wc -l < "$OUT/datasets.tsv") - 1 ))
  done_=$(ls "$OUT"/datasets/*/_SUCCESS 2>/dev/null | wc -l)
  echo "Datasets complete: $done_ / $planned   (output: $OUT)"
  if command -v wr >/dev/null && wr manager status >/dev/null 2>&1; then
    wr status -i tfpm-mine -o s 2>/dev/null || true
    wr status -i tfpm-aggregate -o s 2>/dev/null || true
    echo "Failed shards: wr status -i tfpm-mine -b   |  retry: wr retry -i tfpm-mine -b"
  fi
  if [ -f "$OUT/logs/local.started" ]; then
    echo "Local shards finished: $(cat "$OUT/logs/shards.done" 2>/dev/null | wc -l) / $SHARDS, failed: $(cat "$OUT/logs/shards.failed" 2>/dev/null | wc -l)"
    [ -f "$OUT/logs/local.finished" ] && echo "Local run + aggregate finished."
  fi
  [ -f "$OUT/aggregate/summary.json" ] && { echo "Aggregate summary:"; cat "$OUT/aggregate/summary.json"; }
  local rep="${TFPM_REP_OUT:-$OUT/replication_ts}"
  if [ -f "$rep/contexts.tsv" ]; then
    echo "Replication contexts done: $(ls "$rep"/groups/*.done 2>/dev/null | wc -l) / $(( $(wc -l < "$rep/contexts.tsv") - 1 ))"
    command -v wr >/dev/null && wr manager status >/dev/null 2>&1 && { wr status -i tfpm-rep -o s 2>/dev/null; wr status -i tfpm-rep-aggregate -o s 2>/dev/null; } || true
    [ -f "$rep/aggregate/summary.json" ] && cat "$rep/aggregate/summary.json"
  fi
  for d in "$OUT"/atac_catlas "$OUT"/atac_catlas_proxy_fetal; do [ -f "$d/manifest.json" ] || continue
    echo "ATAC $(basename "$d"): scan $(ls "$d"/scan/*.done.json 2>/dev/null | wc -l)/$(wc -l < "$d/scan_jobs.txt" 2>/dev/null || echo 0), analyze $(ls "$d"/analysis/*.done.json 2>/dev/null | wc -l)/$(wc -l < "$d/analyze_jobs.txt" 2>/dev/null || echo 0)"
    command -v wr >/dev/null && wr manager status >/dev/null 2>&1 && for g in scan compile analyze aggregate; do wr status -i tfpm-atac-$g -o s 2>/dev/null; done || true
    [ -f "$d/aggregate/summary.json" ] && cat "$d/aggregate/summary.json"; done
  return 0
}

cmd_publish(){
  local label="" run="$OUT" latest="" embed=""
  while [ $# -gt 0 ]; do case "$1" in
    --label) label="$2"; shift 2;; --run) run="$(readlink -m "$2")"; shift 2;; --no-latest) latest="--no-latest"; shift;; --embed) embed=1; shift;;
    *) die "unknown option $1";; esac; done
  [ -f "$run/manifest.json" ] || die "no run at $run"
  [ -f "$run/aggregate/summary.json" ] || OUT="$run" cmd_aggregate
  "$PY" "$ROOT/scripts/export_site.py" --run "$run" --site-data "$ROOT/docs/data" \
        --priors "$COMP/interaction_priors.tsv" --label "$label" $latest
  [ -n "$embed" ] && cmd_embed --run "$run"
  if ls "$run"/atac_catlas*/compiled/hits.npy >/dev/null 2>&1; then   # ATAC plots: cross-cluster stats, motifs, spacing
    local rid; rid=$(cat "$run/aggregate/published_run_id")
    "$PY" "$ROOT/scripts/atac_views.py" --run "$run" --site-run-dir "$ROOT/docs/data/runs/$rid" \
      --catlas-h5ad "${TFPM_CATLAS_INPUTS:-$(dirname "$run")/catlas_inputs}/catlas_binary_atac.h5ad" \
      ${TFPM_GENOME_FASTA:+--genome-fasta "$TFPM_GENOME_FASTA"} --fimo "${TFPM_FIMO:-fimo}" --bedtools "${TFPM_BEDTOOLS:-bedtools}" || die "atac views failed"
  fi
  cd "$ROOT"; git add docs/data
  git commit -q -m "Publish mining run $(basename "$run") ($(date +%F))${label:+: $label}" || { echo "Nothing new to publish."; return 0; }
  git pull -q --rebase && git push -q && echo "Published. The site updates in ~1 minute: https://double2strand.github.io/TFpairminer/"
}

cmd_embed(){
  local run="$OUT" args=()
  while [ $# -gt 0 ]; do case "$1" in --run) run="$(readlink -m "$2")"; shift 2;; *) args+=("$1"); shift;; esac; done
  [ -f "$run/aggregate/published_run_id" ] || die "publish the run first (tfpm publish --run $run)"
  "$PY" -c 'import scanpy' 2>/dev/null || "$PY" -m pip install -q scanpy umap-learn
  "$PY" "$ROOT/scripts/embed_export.py" --run "$run" --site-data "$ROOT/docs/data" --run-id "$(cat "$run/aggregate/published_run_id")" "${args[@]}"
}

# ---- replication (Tabula Sapiens validation; mining/tabula_sapiens_validate.py) ----
REPV="$ROOT/mining/tabula_sapiens_validate.py"
cmd_replicate(){
  local run="$OUT" runner="" par=4 plan_args=()
  while [ $# -gt 0 ]; do case "$1" in
    --run) run="$(readlink -m "$2")"; shift 2;; --runner) runner="$2"; shift 2;; --parallel|-P) par="$2"; shift 2;;
    --) shift; plan_args=("$@"); break;; *) die "unknown option $1";; esac; done
  local rep="${TFPM_REP_OUT:-$run/replication_ts}"
  [ -f "$run/aggregate/cell_type_pair_candidates.tsv" ] || die "no discovery aggregate in $run (run tfpm mine first)"
  if [ ! -f "$rep/manifest.json" ]; then (cd "$ROOT/mining" && "$PY" "$REPV" plan --discovery-run "$run" --out "$rep" "${plan_args[@]}"); fi
  local nctx; nctx=$(( $(wc -l < "$rep/contexts.tsv") - 1 ))
  local shards="${TFPM_REP_SHARDS:-$(( nctx < 100 ? nctx : 100 ))}"; [ "$shards" -ge 1 ] || shards=1
  mkdir -p "$rep/logs"; : > "$rep/jobs.txt"
  for ((i=0;i<shards;i++)); do echo "cd $ROOT/mining && $PY $REPV run --out $rep --num-shards $shards --shard-index $i --batch-size 1000 --tmpdir \"\${TMPDIR:-/tmp}\"" >> "$rep/jobs.txt"; done
  case "$runner" in
    wr) command -v wr >/dev/null || die "wr not on PATH"; wr manager status >/dev/null 2>&1 || die "start a wr manager first: wr manager start"
        local q=(); [ -n "${TFPM_WR_QUEUE:-}" ] && q=(--queue "$TFPM_WR_QUEUE")
        wr add -f "$rep/jobs.txt" -i tfpm-rep -e tfpm_rep_shards -m "${TFPM_WR_MEM:-32G}" -t "${TFPM_WR_TIME:-24h}" --cpus "${TFPM_WR_CPUS:-4}" -r 3 "${q[@]}"
        echo "$ROOT/tfpm replicate-aggregate --run $run" | wr add -i tfpm-rep-aggregate -d tfpm_rep_shards -m 8G -t 2h -r 1 "${q[@]}"
        echo "Queued $shards replication shard(s) + aggregate. Check: tfpm status --run $run";;
    local) setsid nohup bash -c "xargs -P $par -I{} bash -c '{}' < '$rep/jobs.txt' > '$rep/logs/local.log' 2>&1; '$ROOT/tfpm' replicate-aggregate --run '$run' >> '$rep/logs/local.log' 2>&1 && touch '$rep/logs/local.finished'" >/dev/null 2>&1 &
        echo "Started $shards replication shard(s) locally ($par parallel). Check: tfpm status --run $run";;
    *) die "use --runner wr or --runner local";;
  esac
}
cmd_rep_aggregate(){
  local run="$OUT"; [ "${1:-}" = "--run" ] && run="$(readlink -m "$2")"
  local rep="${TFPM_REP_OUT:-$run/replication_ts}" stamp; stamp=$(date +%Y%m%d-%H%M%S)
  [ -d "$rep/aggregate" ] && mv "$rep/aggregate" "$rep/aggregate.old.$stamp"
  [ -f "$rep/candidate_summary.sqlite" ] && mv "$rep/candidate_summary.sqlite" "$rep/candidate_summary.sqlite.old.$stamp"
  (cd "$ROOT/mining" && "$PY" "$REPV" aggregate --out "$rep")
}

# ---- scATAC layer: CATlas same-cCRE motif co-enrichment (mining/catlas_pipeline.py) ----
CATP="$ROOT/mining/catlas_pipeline.py"
cmd_atac(){
  local run="$OUT" runner="" par=4 nscan="${TFPM_ATAC_SCAN_SHARDS:-32}" nana="${TFPM_ATAC_ANALYZE_SHARDS:-16}" proxy=() plan_args=()
  while [ $# -gt 0 ]; do case "$1" in
    --run) run="$(readlink -m "$2")"; shift 2;; --runner) runner="$2"; shift 2;; --parallel|-P) par="$2"; shift 2;;
    --scan-shards) nscan="$2"; shift 2;; --analyze-shards) nana="$2"; shift 2;;
    --proxy-fetal) proxy+=("$2"); shift 2;;   # "CATlas fetal cluster=CL:xxxx[@UBERON:yyyy]", repeatable; labelled proxy_fetal, never exact
    --) shift; plan_args=("$@"); break;; *) die "unknown option $1";; esac; done
  [ "$runner" = wr ] || [ "$runner" = local ] || die "use --runner wr or --runner local"
  local rep="${TFPM_REP_OUT:-$run/replication_ts}" inputs="${TFPM_CATLAS_INPUTS:-$(dirname "$run")/catlas_inputs}"
  local fasta="${TFPM_GENOME_FASTA:-}" fimo="${TFPM_FIMO:-fimo}" bedtools="${TFPM_BEDTOOLS:-bedtools}"
  local cs="$rep/aggregate/candidate_summary.tsv.gz"; [ -f "$cs" ] || die "no replication summary at $cs (run tfpm replicate first)"
  local out="$run/atac_catlas"; [ ${#proxy[@]} -gt 0 ] && out="$run/atac_catlas_proxy_fetal"
  [ -f "$inputs/catlas_binary_atac.h5ad" ] || "$PY" "$CATP" fetch --out "$inputs"
  local h5="$inputs/catlas_binary_atac.h5ad"
  if [ ! -f "$out/manifest.json" ]; then
    local cm=()
    if [ ${#proxy[@]} -gt 0 ]; then
      mkdir -p "$out.inputs"; printf 'catlas_cluster\tcell_type_id\ttissue_id\tstage\tmapping_tier\treviewed\n' > "$out.inputs/crosswalk.tsv"
      for x in "${proxy[@]}"; do local cl="${x%%=*}" rest="${x#*=}"; local ct="${rest%%@*}" ti=""; [ "$rest" != "$ct" ] && ti="${rest#*@}"
        printf '%s\t%s\t%s\tfetal\tproxy_fetal\tYes\n' "$cl" "$ct" "$ti" >> "$out.inputs/crosswalk.tsv"; done
      cm=(--cluster-map "$out.inputs/crosswalk.tsv")
    fi
    "$PY" "$CATP" plan --candidate-summary "$cs" --catlas-h5ad "$h5" --ontology "$inputs/catlas_cell_ontology.tsv" \
        --meme "$inputs/jaspar2026_core_vertebrates.meme" --out "$out" "${cm[@]}" "${plan_args[@]}" >/dev/null || die "plan failed"
  fi
  local mapped; mapped=$("$PY" -c "import json;print(json.load(open('$out/manifest.json'))['n_mapped_rows'])")
  mkdir -p "$out/logs"
  if [ "$mapped" = 0 ]; then
    echo "No CATlas cluster matches these cell types (see $out/mapping_review.tsv); recording the coverage gap."
    "$PY" "$CATP" aggregate --out "$out"; return
  fi
  [ -n "$fasta" ] && [ -f "$fasta" ] || die "$mapped mapped rows need motif scanning: set TFPM_GENOME_FASTA to an uncompressed chr-prefixed hg38 FASTA"
  : > "$out/scan_jobs.txt"; : > "$out/analyze_jobs.txt"
  for ((i=0;i<nscan;i++)); do echo "$PY $CATP scan --out $out --catlas-h5ad $h5 --genome-fasta $fasta --fimo $fimo --bedtools $bedtools --num-shards $nscan --shard-index $i --tmpdir \"\${TMPDIR:-/tmp}\"" >> "$out/scan_jobs.txt"; done
  for ((i=0;i<nana;i++)); do echo "$PY $CATP analyze --out $out --catlas-h5ad $h5 --num-shards $nana --shard-index $i" >> "$out/analyze_jobs.txt"; done
  local compile="[ -f $out/compiled/hits.npy ] || $PY $CATP compile --out $out" agg="[ -f $out/aggregate/summary.json ] || $PY $CATP aggregate --out $out"
  if [ "$runner" = wr ]; then
    command -v wr >/dev/null || die "wr not on PATH"; wr manager status >/dev/null 2>&1 || die "start a wr manager first: wr manager start"
    local q=(); [ -n "${TFPM_WR_QUEUE:-}" ] && q=(--queue "$TFPM_WR_QUEUE")
    wr add -f "$out/scan_jobs.txt" -i tfpm-atac-scan -e tfpm_atac_scan -m 12G -t 24h --cpus 2 -r 3 "${q[@]}"
    echo "$compile" | wr add -i tfpm-atac-compile -e tfpm_atac_compile -d tfpm_atac_scan -m 8G -t 4h -r 1 "${q[@]}"
    wr add -f "$out/analyze_jobs.txt" -i tfpm-atac-analyze -e tfpm_atac_analyze -d tfpm_atac_compile -m 12G -t 12h -r 3 "${q[@]}"
    echo "$agg" | wr add -i tfpm-atac-aggregate -d tfpm_atac_analyze -m 8G -t 2h -r 1 "${q[@]}"
    echo "Queued $nscan scan + compile + $nana analyze + aggregate. Check: tfpm status --run $run"
  else
    setsid nohup bash -c "set -e; xargs -P $par -I{} bash -c '{}' < '$out/scan_jobs.txt'; $compile; xargs -P $par -I{} bash -c '{}' < '$out/analyze_jobs.txt'; $agg; touch '$out/logs/local.finished'" > "$out/logs/local.log" 2>&1 &
    echo "Started CATlas scan/analyze locally ($par parallel); log $out/logs/local.log"
  fi
}

case "${1:-}" in
  setup) shift; cmd_setup "$@";; mine) shift; cmd_mine "$@";; status) cmd_status;;
  publish) shift; cmd_publish "$@";; aggregate) cmd_aggregate;; replicate) shift; cmd_replicate "$@";; atac) shift; cmd_atac "$@";; replicate-aggregate) shift; cmd_rep_aggregate "$@";; embed) shift; cmd_embed "$@";; *) usage;;
esac
